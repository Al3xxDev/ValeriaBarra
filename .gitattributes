# ==============================================================================
# Git Attributes & Line Endings Configuration
# ==============================================================================

# Auto-detect text files and normalize line endings to LF across all operating systems
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Source Code & Text Assets
# ------------------------------------------------------------------------------
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.env.example text eol=lf

# ------------------------------------------------------------------------------
# Binary Media & Font Assets
# ------------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# ------------------------------------------------------------------------------
# Archives & Compressed Files
# ------------------------------------------------------------------------------
*.gz binary
*.tar binary
*.zip binary
