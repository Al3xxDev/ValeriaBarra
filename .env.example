# ==============================================================================
# Valeria Barra · Biologist Nutritionist Platform
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit your `.env` file containing real secrets to version control.
# - In production, configure environment variables via your hosting provider
#   (e.g., Vercel, AWS, Fly.io, Railway) or container orchestration secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string.
# Default format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local Docker Compose development, the credentials below match `docker-compose.yml`:
DATABASE_URL="postgresql://valeria:valeria@localhost:5432/valeria_barra?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Security (Required)
# ------------------------------------------------------------------------------
# High-entropy random secret key (minimum 32 characters) used to sign JWT sessions.
# Generate a cryptographically secure token using:
#   openssl rand -hex 32
AUTH_SECRET="replace-with-at-least-32-random-characters-in-production"

# Initial administrator credentials used by the database seeder (`npm run db:seed`).
# In production, change the password immediately through the admin settings.
ADMIN_EMAIL="admin@valeriabarra.local"
ADMIN_PASSWORD="change-this-development-password"

# ------------------------------------------------------------------------------
# 3. Public Site URL & SEO (Required for Metadata & Sitemap)
# ------------------------------------------------------------------------------
# Canonical URL of the website without trailing slash.
# Used for absolute OpenGraph URLs, JSON-LD structured metadata, and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX).
# The GA script is loaded only if configured and after explicit user consent.
# Leave blank to disable analytics completely.
NEXT_PUBLIC_GA_ID=""

# ------------------------------------------------------------------------------
# 4. Email Notifications via Resend (Optional)
# ------------------------------------------------------------------------------
# Resend API key for automated appointment confirmations and studio alerts.
# If omitted or left empty, booking requests are saved to PostgreSQL without sending emails.
RESEND_API_KEY=""
EMAIL_FROM="Valeria Barra <studio@example.it>"
EMAIL_TO=""

# ------------------------------------------------------------------------------
# 5. Media & File Storage (Required in Production)
# ------------------------------------------------------------------------------
# Set to "true" during local development to store private media in `./.private-media`.
# In production, set to "false" and provide S3 credentials below.
STORAGE_LOCAL="true"

# S3 or S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, Wasabi, etc.)
# Used for securely storing private patient case imagery and media assets.
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="eu-central-1"
