generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum BeforeAfterStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConsentScope {
  CONTENT
  IMAGES
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Amministrazione")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthThrottle {
  key         String   @id
  attempts    Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

model Booking {
  id                  String        @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  phone               String
  appointmentType     String
  preferredDay        DateTime?     @db.Date
  preferredTime       String?
  message             String?       @db.VarChar(1200)
  privacyAcceptedAt   DateTime
  marketingAcceptedAt DateTime?
  status              BookingStatus @default(NEW)
  internalNotes       String?       @db.VarChar(3000)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  recipes   Recipe[]
  createdAt DateTime  @default(now())
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  articles Article[]
  recipes  Recipe[]
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  subtitle        String?
  content         String    @db.Text
  coverImage      String?
  coverAlt        String?
  coverMediaId    String?
  coverMedia      MediaAsset? @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  socialImage     String?
  author          String    @default("Valeria Barra")
  published       Boolean   @default(false)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            Tag[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Recipe {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  description        String
  image              String?
  imageAlt           String?
  prepMinutes        Int?
  difficulty         String?
  ingredients        Json
  method             Json
  nutritionFacts     Json?
  mediaAssetId      String?
  mediaAsset        MediaAsset? @relation("RecipeImage", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  published          Boolean   @default(false)
  publishedAt        DateTime?
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               Tag[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([published, publishedAt])
}

model BeforeAfterCase {
  id                    String         @id @default(cuid())
  title                 String
  slug                  String         @unique
  description           String         @db.Text
  goal                  String?
  journey               String?        @db.Text
  duration              String?
  resultDescription     String?        @db.Text
  testimonial           String?        @db.Text
  imageBefore           String?
  imageAfter            String?
  imageBeforeAlt        String?
  imageAfterAlt         String?
  imageBeforeId         String?
  imageAfterId          String?
  beforeMedia           MediaAsset?      @relation("CaseBefore", fields: [imageBeforeId], references: [id], onDelete: SetNull)
  afterMedia            MediaAsset?      @relation("CaseAfter", fields: [imageAfterId], references: [id], onDelete: SetNull)
  status                BeforeAfterStatus @default(DRAFT)
  publishedAt           DateTime?
  contentConsent        Boolean        @default(false)
  imagesConsent         Boolean        @default(false)
  anonymized            Boolean        @default(false)
  isDemo                Boolean        @default(false)
  consentRecordedAt     DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  consentRecords        ConsentRecord[]

  @@index([status, publishedAt])
  @@index([contentConsent, imagesConsent, anonymized])
}

model ConsentRecord {
  id          String           @id @default(cuid())
  caseId      String
  case        BeforeAfterCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  scope       ConsentScope
  granted     Boolean
  recordedAt  DateTime         @default(now())
  withdrawnAt DateTime?
  notes       String?          @db.VarChar(1000)

  @@index([caseId, scope, recordedAt])
  @@index([caseId, scope, granted, withdrawnAt])
}

model MediaAsset {
  id         String   @id @default(cuid())
  storageKey String   @unique
  url        String
  altText    String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  articles   Article[] @relation("ArticleCover")
  recipes    Recipe[] @relation("RecipeImage")
  casesBefore BeforeAfterCase[] @relation("CaseBefore")
  casesAfter  BeforeAfterCase[] @relation("CaseAfter")
}

model SiteSettings {
  id          String   @id @default("main")
  name        String   @default("Valeria Barra")
  qualification String @default("Biologa Nutrizionista")
  shortBio    String   @default("Un percorso nutrizionale costruito intorno alla tua vita, con ascolto e consapevolezza.")
  email       String?
  phone       String?
  whatsapp    String?
  city        String   @default("Salerno")
  instagram   String?
  facebook    String?
  ctaLabel    String   @default("Prenota un appuntamento")
  seoTitle    String?
  seoDescription String?
  updatedAt   DateTime @updatedAt
}
